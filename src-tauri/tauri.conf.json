{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpiderWeb",
  "version": "1.2.0",
  "identifier": "dev.hyprland.spiderweb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpiderWeb Kanban",
        "width": 1420,
        "height": 880,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
